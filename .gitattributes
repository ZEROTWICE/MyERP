# 统一行尾：仓库事实来源为 LF；Windows 专用脚本例外
* text=auto eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
# 二进制：禁止任何行尾/编码转换
*.db binary
*.sqlite binary
*.sqlite3 binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.pyc binary
