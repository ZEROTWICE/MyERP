# Private individual user cursor rules
.cursor/rules/_*.mdc

.env
.env.production

# 本地验证现场与团队运行时状态（不应入库）
.analysis-scratch/
.agent-teams/

# Python 构建产物
__pycache__/
*.pyc

# 沙箱遗留的空临时目录
.tmp_p01/
tmp_p01/

# 本地开发数据库：由 create_all() + db_bootstrap.py（从已跟踪的 app/data.sqlite 播种）重建，
# 不再纳入版本控制；服务器上的真实 app.db 由部署脚本自行备份。
/app.db
/app.db.bak-*

# 测试套件每次运行都会重写的报告产物（permission_matrix.py / smoke_test.py）
/_permission_matrix.json
/_smoke_results.json

# 运行时临时/导出目录：由 create_app() 的 os.makedirs(..., exist_ok=True) 自动创建，
# 且 cleanup_temp_files()（@bp.before_request 钩子，routes.py:2196）会按 mtime>5min 清理。
# 原 6 个 *_template.xlsx 是旧导出实现的遗留产物（导出已改 io.BytesIO 内存生成，无人读取），
# 已取消跟踪并删除；不再入库。
/uploads/temp/

# 手工备份/临时副本（2026-09-18 第 8 批清理时发现仓库里混入了 7 个此类遗留备份，
# 其中 routes.py.backup/.bak/.new 曾被跟踪；今后一律不入库）
*.bak
*.new
*.backup

# ---- 测试战役产出（E-04：CI 需要 harness 与规格文档，故跟踪；大数据与运行时产物不跟踪）----
/test-reports-2026-10/.tmp/
/test-reports-2026-10/evidence/

# ---- 合金钢辙叉导入的原始数据源（业务侧会更新的大体积表格，不入库）----
# 解析与导入代码在 app/utils/alloy_steel_price_converter.py、
# app/utils/alloy_steel_bom_converter.py、app/services/alloy_steel_import_service.py，
# 数据本身通过「导入合金钢辙叉工价标准」/「导入合金钢辙叉 BOM」两个入口上传即可。
/工具/合金钢辙叉计件工价标准.xlsx
/工具/48页表格/

